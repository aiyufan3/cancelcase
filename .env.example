# CancelCase configuration. Every value is read on the server; none is exposed to the browser.
# Fixture mode needs no .env at all. For connected Sandbox mode, copy this file to .env and fill
# in the PayPal values. Never commit .env.

# Fixture mode runs offline: no credentials and no external calls.
APP_MODE=fixture
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data/local
# Recording mode shows aliases instead of real provider identifiers in the UI.
DEMO_RECORDING_MODE=true

# PayPal (Sandbox only; a live origin is refused at startup)
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: buyer-side case creation in Sandbox. It also needs the dispute-create scope on the
# app and the buyer's consent through Log in with PayPal (see the README). This flag alone grants
# nothing, and no buyer password is ever stored or requested.
PAYPAL_ENABLE_BUYER_DISPUTES=false
PAYPAL_BUYER_EMAIL=

# Optional: an existing Sandbox dispute ID (e.g. a case you created manually in the
# Sandbox Resolution Center). Used only by pnpm sandbox:check and sandbox:setup --import-dispute.
PAYPAL_IMPORT_DISPUTE_ID=

# Connected-model drafting (optional, opt-in). Your choice of service, endpoint and model is
# private local configuration: it is never shown in the UI, API responses, exports or logs.
# Fixture mode uses labelled deterministic drafting even if a key is present.
LLM_ENABLED=false
# Transport: "openai" (OpenAI-compatible Chat Completions) or "anthropic" (Messages API).
LLM_PROVIDER=
# Base URL exactly as your service documents it for its SDK (required, https).
# The client appends /chat/completions ("openai") or /v1/messages ("anthropic").
# Fictional example: https://llm.example.invalid/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional: reasoning_effort (none|minimal|low|medium|high), sent only when set and only by the
# "openai" transport, for services that document it. Optional output token budget (256-16384).
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=

# Optional LangSmith tracing of the agent's graph runs (docs/observability.md). Off unless
# LANGSMITH_TRACING=true and LANGSMITH_API_KEY are both set; the switch without a key stops the
# app at startup. Runs are redacted before they leave this machine and carry no drafts, evidence
# or PayPal payloads. LangChain's own switches (LANGCHAIN_TRACING_V2 and the like) are refused.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cancelcase

# Reserved for webhook verification. Webhooks are not implemented: there is no public route.
PAYPAL_WEBHOOK_ID=
